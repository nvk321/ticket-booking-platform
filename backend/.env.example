# ======================================================================
# TicketFlow Backend Environment Configuration
# ======================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/theatre_saas"
POSTGRES_DB="theatre_saas"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="admin"
POSTGRES_PORT="5432"

# Security & Authentication (JWT)
JWT_SECRET="ticketflow-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"
JWT_EXPIRES_IN="7d"

# Business Logic & Expiration Rules (TTL)
SEAT_HOLD_TTL_MINUTES="5"
WAITLIST_OFFER_TTL_MINUTES="15"

# Server & Network Configuration
PORT="5000"
CLIENT_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# Notifications & Email Delivery (Mock for local dev)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
