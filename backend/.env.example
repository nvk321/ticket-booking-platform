# ======================================================================
# TicketFlow Backend Environment Configuration
# ======================================================================

# Database Connection (PostgreSQL)
# For local development with Docker Compose:
DATABASE_URL="postgresql://postgres:admin@localhost:5432/theatre_saas"
# For production managed database (e.g. Render/Railway/Supabase):
# DATABASE_URL="postgresql://user:password@hostname:5432/ticketflow_db"

# Security & Authentication (JWT)
# IMPORTANT: In production, generate a secure random secret (min 32 characters)
JWT_SECRET="ticketflow-secret-key-change-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Application Environment (development | production)
ENVIRONMENT="development"

# Business Logic & Expiration Rules (TTL)
SEAT_HOLD_TTL_MINUTES="5"
WAITLIST_OFFER_TTL_MINUTES="15"
BACKGROUND_SWEEPER_INTERVAL_SECONDS="30"

# Frontend URL & CORS Origins
# Comma-separated list of allowed origins (e.g. for Vercel deployment)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Notifications & Email Delivery
# Use 'mock' for local development; 'production' or SMTP for live mail dispatch
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="noreply@ticketflow.dev"
