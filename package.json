{
  "name": "ticketflow",
  "version": "1.0.0",
  "description": "TicketFlow — Smart Ticket Booking Platform",
  "private": true,
  "scripts": {
    "postgres:up": "docker compose up -d postgres",
    "postgres:down": "docker compose down",
    "postgres:status": "docker compose ps",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:migrate": "npm --prefix backend run db:migrate",
    "backend:seed": "npm --prefix backend run db:seed",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "keywords": [
    "ticket-booking",
    "ticketflow",
    "seat-selection",
    "concurrency",
    "waitlist",
    "real-time"
  ],
  "author": "TicketFlow Team",
  "license": "MIT"
}
