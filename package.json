{
  "name": "ticketflow",
  "version": "1.0.0",
  "description": "TicketFlow — Smart Ticket Booking Platform",
  "private": true,
  "scripts": {
    "postgres:up": "docker compose up -d postgres",
    "postgres:down": "docker compose down",
    "postgres:status": "docker compose ps",
    "backend:install": "cd backend && pip install -r requirements.txt",
    "backend:dev": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 5000 --reload",
    "backend:seed": "cd backend && python seed.py",
    "backend:test": "cd backend && pytest",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "cd backend && pytest"
  },
  "keywords": [
    "ticket-booking",
    "ticketflow",
    "fastapi",
    "pydantic",
    "sqlalchemy",
    "react",
    "typescript",
    "seat-selection",
    "concurrency",
    "waitlist",
    "real-time"
  ],
  "author": "TicketFlow Team",
  "license": "MIT"
}
